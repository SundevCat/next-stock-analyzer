# Optional: MongoDB connection for favourites persistence (without it, favourites use in-memory fallback per server instance — not suitable for production serverless scaling)
MONGODB_URI=mongodb://localhost:27017/stock_analyzer
# Atlas (example — put real URI in .env.local; URL-encode special chars in password):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
# Code always uses DB name stock_analyzer (see src/lib/mongodb.ts).

# Optional: override Yahoo Finance cookie / crumb if requests are blocked (rare)
# YAHOO_COOKIE=
# YAHOO_CRUMB=
